{
  "name": "Ubuntu 26.04 desktop (Selkies)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "runArgs": ["--shm-size=16g"],
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Desktop", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/install-desktop.sh",
  "postStartCommand": "bash .devcontainer/start-desktop.sh"
}
